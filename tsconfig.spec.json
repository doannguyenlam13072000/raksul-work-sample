{
    "extends": "@vue/tsconfig/tsconfig.dom.json",
    "compilerOptions": {
      "composite": false,
      "module": "CommonJS",
      "moduleResolution": "node",
      "verbatimModuleSyntax": false,
      "types": [
        "jest",
        "node"
      ],
      "baseUrl": ".",
      "paths": {
        "@/*": ["src/*"]
      }
    },
    "include": [
      "src/**/*.ts",
      "src/**/*.d.ts",
      "src/**/*.vue",
      "src/tests/**/*.ts"
    ]
  }